{
  "name": "sparky-mcp",
  "version": "0.1.6",
  "description": "Self-hosted MCP server and CLI for the Sparky app",
  "private": true,
  "type": "module",
  "engines": { "bun": ">=1.3" },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig src/main.ts --outfile dist/sparky-mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.0.0"
  }
}
