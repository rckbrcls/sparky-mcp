# Public HTTPS URL of this server (Tailscale Funnel / reverse proxy), no trailing slash.
PUBLIC_URL=https://your-host.your-tailnet.ts.net

# Bearer token used by the Sparky app and by local MCP clients (Claude Code, Codex).
# Generate one with: openssl rand -hex 32
API_TOKEN=

# Password shown on the OAuth consent page when you add the connector in Claude or ChatGPT.
ADMIN_PASSWORD=

# Optional
PORT=8787
DATA_DIR=./data
USER_TIMEZONE=America/Sao_Paulo
